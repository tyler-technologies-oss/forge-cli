{
  "name": "@tylertech/forge-cli",
  "version": "3.1.1",
  "description": "A CLI for managing Tyler Forge™ Web Component projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyler-technologies-oss/forge-cli.git"
  },
  "type": "module",
  "bin": {
    "forge": "bin/forge.js"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "package": "./package.json",
    "import": "./dist/index.js"
  },
  "typings": "./dist/index.d.ts",
  "author": "Tyler Technologies, Inc.",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "config",
    "dist"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run lint && rimraf ./dist && tsc",
    "build:watch": "tsc -w",
    "lint": "eslint ./src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@tylertech/forge-build-tools": "^3.1.1",
    "canonical-path": "^1.0.0",
    "chalk": "^5.4.1",
    "command-line-usage": "^7.0.3",
    "deepmerge": "^4.3.1",
    "esbuild": "^0.25.8",
    "glob": "^11.0.3",
    "inquirer": "^12.8.2",
    "js-string-escape": "^1.0.1",
    "minimist": "^1.2.8",
    "moment": "^2.30.1"
  },
  "peerDependencies": {
    "sass": "^1.89.2",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tylertech-eslint/eslint-plugin": "^3.0.0",
    "@types/command-line-usage": "^5.0.4",
    "@types/inquirer": "9.0.8",
    "@types/js-string-escape": "^1.0.3",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.1.0",
    "commitlint": "^19.8.1",
    "eslint": "^9.31.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3"
  }
}
